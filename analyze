#!/bin/bash -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

cd "${SCRIPT_DIR}"

echo "========================================"
echo "SC26 artifact analysis"
echo "========================================"
echo

echo "[1/4] Extracting experiment results..."
echo

python3 fetch_results.py \
    --results results

echo
echo "[2/4] Aggregating experiment results..."
echo

python3 aggregate_results.py \
    --results results \
    --output results/processed

echo
echo "[3/4] Generating comparison figures..."
echo

python3 generate_figures.py \
    --input results/processed \
    --output results/figures

echo
echo "[4/4] Generating timeline figures..."
echo

python3 generate_timeline.py \
    --results results \
    --output results/figures/timeline

echo
echo "========================================"
echo "Analysis complete"
echo "========================================"

